<div class="sidebar-shell">
  <a href="/" class="sidebar-logo" aria-label="X home"><img src="/images/logo.png" alt="X"></a>
  <nav class="sidebar-nav" aria-label="Primary navigation">
    <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Home</span></a>
    <a href="/explore"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span>Explore</span></a>
    <a href="/notifications"><i class="fa-regular fa-bell" aria-hidden="true"></i><span>Notifications</span></a>
    <a href="/messages"><i class="fa-regular fa-comments" aria-hidden="true"></i><span>Chat</span></a>
    <a href="/bookmarks"><i class="fa-regular fa-bookmark" aria-hidden="true"></i><span>Bookmarks</span></a>
    <a href="/profile"><i class="fa-regular fa-user" aria-hidden="true"></i><span>Profile</span></a>
  </nav>
  <a href="#" class="btn post-button">Post</a>
  <div class="sidebar-user">
    <% if (currentUser && currentUser.profilePicture) { %>
      <img class="user-avatar-image" src="<%= currentUser.profilePicture %>" alt="">
    <% } else { %>
      <i class="fa-solid fa-circle-user user-avatar" aria-hidden="true"></i>
    <% } %>
    <div>
      <strong><%= currentUser ? currentUser.displayName : "Guest" %></strong>
      <small><%= currentUser ? `@${currentUser.username}` : "Log in to personalize" %></small>
    </div>
    <% if (currentUser) { %>
      <form class="sidebar-logout-form" action="/logout" method="POST">
        <button class="sidebar-logout-button" type="submit" aria-label="Log out" title="Log out">
          <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
        </button>
      </form>
    <% } else { %>
      <a href="/login" aria-label="Log in"><i class="fa-solid fa-arrow-right-to-bracket" aria-hidden="true"></i></a>
    <% } %>
  </div>
</div>
