<article class="post-card">
  <a class="post-avatar-link" href="/user/<%= post.author.username %>">
    <% if (post.author.profilePicture?.url) { %><img class="user-avatar-image post-avatar" src="<%= post.author.profilePicture.url %>" alt=""><% } else { %><span class="post-avatar-fallback"><%= (post.author.displayName || post.author.username || "U").slice(0, 1).toUpperCase() %></span><% } %>
  </a>
  <div class="post-main">
    <div class="post-heading"><a href="/user/<%= post.author.username %>"><strong><%= post.author.displayName || post.author.username %></strong> <span>@<%= post.author.username %></span></a><span aria-hidden="true">·</span><a class="post-date" href="/posts/<%= post._id %>"><%= new Date(post.createdAt).toLocaleString() %></a><% if (post.isEdited) { %><small>· edited</small><% } %>
      <% if (currentUser && currentUser._id?.toString() === post.author._id?.toString()) { %><div class="dropdown ms-auto"><button class="post-menu-button" data-bs-toggle="dropdown" aria-label="Post options"><i class="fa-solid fa-ellipsis"></i></button><ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end"><li><a class="dropdown-item" href="/posts/<%= post._id %>/edit">Edit post</a></li><li><form action="/posts/<%= post._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this post?')"><button class="dropdown-item text-danger" type="submit">Delete post</button></form></li></ul></div><% } %>
    </div>
    <% if (post.content) { %><p class="post-content"><%= post.content %></p><% } %>
    <% if (post.media?.length) { %><div class="post-media-grid media-count-<%= Math.min(post.media.length, 4) %>"><% post.media.forEach((item) => { %><img src="<%= item.url %>" alt="Image attached to post" class="post-media" loading="lazy"><% }) %></div><% } %>
    <div class="post-actions"><a href="/posts/<%= post._id %>"><i class="fa-regular fa-comment"></i><span>Reply</span></a><button type="button" title="Like (coming soon)" disabled><i class="fa-regular fa-heart"></i><span>Like</span></button><button type="button" title="Share" onclick="navigator.clipboard?.writeText(location.origin + '/posts/<%= post._id %>')"><i class="fa-solid fa-arrow-up-from-bracket"></i><span>Share</span></button></div>
  </div>
</article>
