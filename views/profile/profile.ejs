<% layout("layouts/boilerplate") %>

<section class="profile-page">
  <div class="profile-page-header">
    <a class="profile-back-link" href="/" aria-label="Back to home">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    </a>
    <div>
      <h1 class="h5 mb-0"><%= profileUser.displayName %></h1>
      <small class="text-secondary">Profile</small>
    </div>
  </div>

  <% if (profileUser.coverPicture) { %>
    <img class="profile-cover-image" src="<%= profileUser.coverPicture %>" alt="">
  <% } else { %>
    <div class="profile-cover-placeholder" aria-hidden="true"></div>
  <% } %>

  <div class="profile-page-content">
    <% if (profileUser.profilePicture) { %>
      <img class="profile-page-avatar" src="<%= profileUser.profilePicture %>" alt="<%= profileUser.displayName %>">
    <% } else { %>
      <i class="fa-solid fa-circle-user profile-page-avatar-placeholder" aria-hidden="true"></i>
    <% } %>

    <% if (currentUser && currentUser.username === profileUser.username) { %>
      <a class="btn btn-outline-light rounded-pill profile-edit-button" href="/profile/edit">Edit profile</a>
    <% } %>

    <h2 class="h4 mb-1"><%= profileUser.displayName %></h2>
    <p class="text-secondary mb-3">@<%= profileUser.username %></p>

    <% if (profileUser.bio) { %>
      <p class="profile-bio"><%= profileUser.bio %></p>
    <% } %>

    <div class="profile-details">
      <% if (profileUser.location) { %>
        <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= profileUser.location %></span>
      <% } %>
      <% if (profileUser.website) { %>
        <a href="<%= profileUser.website %>" target="_blank" rel="noopener noreferrer">
          <i class="fa-solid fa-link" aria-hidden="true"></i><%= profileUser.website %>
        </a>
      <% } %>
      <% if (profileUser.dateOfBirth) { %>
        <span><i class="fa-solid fa-cake-candles" aria-hidden="true"></i>Born <%= new Date(profileUser.dateOfBirth).toLocaleDateString() %></span>
      <% } %>
      <% if (profileUser.createdAt) { %>
        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i>Joined <%= new Date(profileUser.createdAt).toLocaleDateString() %></span>
      <% } %>
    </div>

    <div class="profile-follow-counts">
      <span><strong>0</strong> Following</span>
      <span><strong>0</strong> Followers</span>
    </div>
  </div>
</section>
