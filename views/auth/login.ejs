<% layout("layouts/auth_layout") %>

<div class="container py-5 auth-container">
  <%- include("../partials/flash") %>
  <div class="card border-secondary shadow-lg auth-card">
    <div class="card-body p-4 p-md-5">
      <div class="auth-brand mb-4">
        <a href="/" class="text-decoration-none" aria-label="Go to home">
          <img src="/images/logo.png" alt="X" width="40" height="40">
        </a>
        <span>Welcome back</span>
      </div>
      <%- include("../partials/auth-tabs", { activeAuthTab }) %>
      <div class="mb-4">
        <h1 class="h3 mb-2">Sign in to X</h1>
        <p class="text-secondary mb-0">Pick up where you left off.</p>
      </div>

      <form action="/login" method="POST" novalidate>
        <div class="mb-3">
          <label class="form-label" for="identifier">Email or username</label>
          <input class="form-control" id="identifier" name="identifier" type="text" autocomplete="username" required>
        </div>
        <div class="mb-4">
          <label class="form-label" for="password">Password</label>
          <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
        </div>
        <button class="btn btn-light w-100 rounded-pill fw-bold" type="submit">Log in</button>
      </form>

      <p class="text-secondary mt-4 mb-0">New here? <a href="/register">Create an account</a></p>
    </div>
  </div>
</div>
